<?
  $Loader->Parent_Class('/Object');
  $Loader->Load_Lib('/FS/Utils');
  
  class C_Builder_Compiler_CPP_VC_Find extends C_Object
  {
    var $Regs=[
      'HKLM\SOFTWARE\Microsoft\VisualStudio\SxS\VS7',
      'HKCU\SOFTWARE\Microsoft\VisualStudio\SxS\VS7',
      'HKLM\SOFTWARE\Wow6432Node\Microsoft\VisualStudio\SxS\VS7',
      'HKCU\SOFTWARE\Wow6432Node\Microsoft\VisualStudio\SxS\VS7',
    ];

    function Find($Manager)
    {
      $Res=[];
      $this->Log('Log', 'Search installed Visual Studios');
       
      $this->Find_Installer($Res);
      If($Res) Return $Res; //&& $Forse
      
      $this->Find_Regestry($Res);
      $this->Find_Programs($Res, $Manager);
      
    //$this->Log('Debug', 'Find:')->Debug($Res);
      return $Res;
    }
    
    Function Find_Installer(Array &$Res)
    {
      $VsWhere =GetEnv('ProgramFiles(x86)').'\\Microsoft Visual Studio\\Installer\\vswhere.exe';
      If(!Is_File($VsWhere)) Return;
      
      $this->Log('Log', '   Installer...');
      
      $Cmd='"'.$VsWhere.'" -all -format json';
      $Json = Shell_Exec($Cmd);
      $Instances = Json_DeCode($Json, True);
      ForEach($Instances as $Item)
      {
          $Name    =$Item['displayName'         ];
          $Version =$Item['installationVersion' ];
          $Path    =$Item['installationPath'    ];
          $Catalog =$Item['catalog']?? [];
          
          $productLineVersion = $Catalog['productLineVersion']?? '';
          $Year=$this->DetectYear($Name)
            ?? (StrLen($productLineVersion)==4? $productLineVersion: Null)
            ?? '?';
          $Res[Path_Key($Path)]=[
            'Path'      =>Path_Simplify($Path),
            'RegVer'    =>'?', 
            'VerDetect' =>$Year,
          ]; //explode('.', $k)
      }
    }
    
    Function Find_Regestry(Array &$Res)
    {
      $this->Log('Log', '   Regestry...');
      $Reg=$this->Create_Object('/System/Reg');
      $List=$Reg->SearchParam(
        [
         'HKLM\SOFTWARE\Microsoft\VisualStudio\SxS\VS7',
         'HKCU\SOFTWARE\Microsoft\VisualStudio\SxS\VS7',
         'HKLM\SOFTWARE\Wow6432Node\Microsoft\VisualStudio\SxS\VS7',
         'HKCU\SOFTWARE\Wow6432Node\Microsoft\VisualStudio\SxS\VS7',
        ]
      );
      ForEach($List As $Item)
        ForEach($Item As $k=>$v)
          $Res[Path_Key($v)]=[
            'Path'   =>Path_Simplify($v),
            'RegVer' =>$k,
          ]; //explode('.', $k)
        //$Res[$v]=['Path'=>$v, 'RegVer'=>[(int)$Ver, (int)$Ver2]];
      $Reg->Done();
    }

    Function Find_Programs(Array &$Res, $Manager)
    {
      $this->Log('Log', '   Programs...');
      // 'E:\\Program Files (x86)\\Microsoft Visual Studio\\2019\\Community' => 'Visual Studio Community 2019',
      ForEach($Manager->Manager->GetInstalledPrograms() As $Key=>$Info)
        If(IsSet($Info['Title']))
        {
          if(StrPos($Info['Title'], 'Visual Studio')===false) continue;
          $v=$Info['Path']?? '';
          If($v==='') Continue;
          $k=Path_Key($v);
          If(IsSet($Res[$k])) continue;
          
          If($Year=$this->DetectYear($Info['Title']))
            $Res[$k]=$Info+['RegVer'=>'?', 'VerDetect'=>$Year];
        }
    }

    Function DetectYear($Str)
    { // 2019, 2022, 2026,
      For($Year=2011, $Max=Date("Y")+2; $Year<$Max; $Year++)
        If(StrPos($Str, $Year)!==false)
          Return $Year;
      Return Null;
    }
  }
?>