<?
  for($F=__FILE__; $F;) if(@include($F=DirName($F)).'/Using.php') break;

  $Loader->GetLogger()->ScriptLog();
  
  $Args=[
  ];
  $Builder=$Loader->Create_Object('/Builder/Manager', $Args);
  $CppCompiler=$Builder->GetCompiler('CPP');
  
  $Loader->Log('Log' ,'All tasks were done');
  
  $CppCompiler->Dispose();
  $Builder->Dispose();
  $Loader->Dispose();
?>